# ClawX Environment Variables

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_PORT=18789

# Development Configuration
VITE_DEV_SERVER_PORT=5173

# Desktop auth / growth API (optional overrides)
# Default base URL falls back to https://id.1m1sj.xin
# CLAWX_DESKTOP_AUTH_BASE_URL=https://id.1m1sj.xin
# Default app id falls back to 10001
# CLAWX_DESKTOP_AUTH_APP_ID=10001

# Optional: if GitHub/nodejs.org downloads fail (e.g. ECONNRESET), set a mirror base URL (no trailing slash):
# BUNDLED_UV_BASE_URL=https://gh-proxy.example/https://github.com/astral-sh/uv/releases/download/0.10.0
# BUNDLED_NODE_BASE_URL=https://npmmirror.com/mirrors/node/v22.16.0
# Or use VPN and set HTTPS_PROXY=http://127.0.0.1:7890

# Release Configuration (CI/CD)
# Apple notarization — required only for stable Mac builds (electron-builder.yml sets mac.notarize: true).
# Beta config (electron-builder.beta.yml) skips notarization by default.
# Only uncomment when values are real (placeholders break builds via dotenv).
# APPLE_ID=your@email.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
# CSC_LINK=/absolute/path/to/certificate.p12
# CSC_KEY_PASSWORD=your_p12_password

# Aliyun OSS upload (scripts/upload-release-to-oss.mjs — AWS SDK v3 S3 client).
# Used after electron-builder --publish never — see docs/oss-publish.md (`release:latest:*`, `release:beta:*`).
# AWS_ACCESS_KEY_ID=your_ram_access_key_id
# AWS_SECRET_ACCESS_KEY=your_ram_access_key_secret
# Optional overrides:
# OSS_BUCKET=1m1sj-claw-installer
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# AWS_REGION=oss-cn-beijing
# OSS_UPLOAD_FORCE=1   # skip version check in scripts/upload-release-to-oss.mjs (always upload)

# Optional GitHub Releases (only if you add provider: github to electron-builder publish)
# GH_TOKEN=github_personal_access_token
